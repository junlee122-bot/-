# Betman Value Analyzer — Python 파이프라인 환경변수
# 이 파일을 .env 로 복사해 값을 채운다. (.env 는 .gitignore 됨, 커밋 금지)

# --- Firebase Firestore (저장 레이어) ---
# 서비스계정 키로 인증. 다음 중 하나로 지정:
#   1) GOOGLE_APPLICATION_CREDENTIALS=서비스계정.json 파일 경로 (로컬 권장)
#   2) FIREBASE_SERVICE_ACCOUNT={...json 문자열...}
#   3) FIREBASE_SERVICE_ACCOUNT_BASE64=<위 JSON 의 base64>  (CI/한줄용)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=

# --- 데이터 소스 모드: mock | live ---
# live = 해외 배당(The Odds API) + 뉴스(RSS). 통계는 항상 mock(실 API 부재).
DATA_SOURCE_MODE=mock

# --- 베트맨 발매 배당 입력: mock | csv | firestore ---
# firestore = 웹 대시보드(/betman)에서 입력한 betman_manual_odds 컬렉션 사용
# csv = data/betman/*.csv 수동 입력. mock = 가짜 배당.
BETMAN_SOURCE=mock
BETMAN_DIR=data/betman

# --- The Odds API (해외 배당, 무료 티어 월 500요청) ---
# https://the-odds-api.com  — eu 리전에 Pinnacle(샤프 기준선) 포함
ODDS_API_KEY=
ODDS_API_REGIONS=eu

# --- RSS 뉴스 피드 (종목별, 콤마 구분). 정식/허용 피드만. ---
# 예) RSS_FEEDS_BASEBALL=https://feed1/rss,https://feed2/rss
RSS_FEEDS_SOCCER=
RSS_FEEDS_BASEBALL=
RSS_FEEDS_BASKETBALL=
